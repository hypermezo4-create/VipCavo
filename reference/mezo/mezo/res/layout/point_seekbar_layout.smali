<?xml version="1.0" encoding="utf-8"?><androidx.preference.FixedSize.PointSeekBarLayout xmlns:android="http://schemas.android.com/apk/res/android"    android:gravity="center_vertical"    android:layout_gravity="center_vertical"    android:orientation="vertical"    android:background="?attr/preferenceItemBackground"    android:clipChildren="false"    android:clipToPadding="false"    android:layout_width="match_parent"    android:layout_height="wrap_content">    <LinearLayout        android:orientation="vertical"        android:paddingTop="@dimen/miuix_preference_item_seekbar_parent_padding_top"        android:paddingBottom="@dimen/miuix_preference_item_seekbar_icon_margin_end"        android:clipToPadding="false"        android:layout_width="match_parent"        android:layout_height="wrap_content">        <LinearLayout            android:gravity="center|start"            android:layout_gravity="center"            android:orientation="horizontal"            android:layout_width="match_parent"            android:layout_height="wrap_content">            <MyScrollTextView                android:textAppearance="@style/Miuix.AppCompat.TextAppearance.PreferenceList"                android:id="@android:id/title"                android:layout_width="wrap_content"                android:layout_height="wrap_content" />            <TextView                android:textAppearance="@style/Miuix.AppCompat.TextAppearance.List.Secondary.Preference"                android:id="@android:id/summary"                android:layout_width="wrap_content"                android:layout_height="wrap_content"                android:layout_marginStart="5dp" />        </LinearLayout>        <LinearLayout            android:orientation="horizontal"            android:layout_width="match_parent"            android:layout_height="wrap_content"            android:layout_marginTop="10dp">            <TextView                android:textAppearance="@style/Miuix.AppCompat.TextAppearance.List.Secondary.Preference"                android:gravity="center"                android:layout_gravity="center_vertical"                android:id="@android:id/text1"                android:layout_width="wrap_content"                android:layout_height="wrap_content"                android:layout_marginStart="3dp" />            <androidx.preference.FixedSize.PointSeekBar                android:layout_gravity="center_vertical"                android:id="@android:id/progress"                android:background="@drawable/shape_corner_matrix"                android:layout_width="0dp"                android:layout_height="@dimen/font_size_view_height"                android:layout_weight="1.0"                android:layout_marginStart="3dp"                android:layout_marginEnd="3dp" />            <TextView                android:textAppearance="@style/Miuix.AppCompat.TextAppearance.List.Secondary.Preference"                android:gravity="center"                android:layout_gravity="center_vertical"                android:id="@android:id/text2"                android:layout_width="wrap_content"                android:layout_height="wrap_content"                android:layout_marginEnd="3dp" />        </LinearLayout>    </LinearLayout></androidx.preference.FixedSize.PointSeekBarLayout>