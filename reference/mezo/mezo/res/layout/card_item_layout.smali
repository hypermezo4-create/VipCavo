<?xml version="1.0" encoding="utf-8"?><LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"    android:orientation="vertical"    android:id="@id/card_info"    android:background="@drawable/card_bg_top"    android:layout_width="match_parent"    android:layout_height="wrap_content"    android:layout_marginTop="15dp"    android:layout_marginStart="15dp"    android:layout_marginEnd="15dp">    <ImageView        android:id="@android:id/icon"        android:layout_width="wrap_content"        android:layout_height="wrap_content"        android:layout_marginTop="@dimen/card_info_margin"        android:scaleX="1.5"        android:scaleY="1.5"        android:paddingStart="15dp" />    <MyScrollTextView        android:id="@android:id/title"        android:layout_width="wrap_content"        android:layout_height="wrap_content"        android:layout_marginTop="@dimen/card_info_title_margin_top"        android:singleLine="true"        android:layout_marginStart="@dimen/card_info_margin"        android:layout_marginEnd="@dimen/card_info_margin"        style="@style/card_title" />    <MyScrollTextView        android:textSize="@dimen/card_info_display_number_text_size"        android:textColor="@color/card_summary_color"        android:id="@android:id/summary"        android:layout_width="wrap_content"        android:layout_height="wrap_content"        android:layout_marginBottom="@dimen/card_info_margin"        android:singleLine="true"        android:drawablePadding="@dimen/card_drawable_padding"        android:textDirection="ltr"        android:layout_marginStart="@dimen/card_info_margin"        android:layout_marginEnd="@dimen/card_info_margin" /></LinearLayout>