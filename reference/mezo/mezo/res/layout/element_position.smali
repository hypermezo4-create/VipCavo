<?xml version="1.0" encoding="utf-8"?><LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"    android:gravity="center_horizontal"    android:layout_gravity="center_horizontal"    android:orientation="vertical"    android:layout_width="match_parent"    android:layout_height="wrap_content">    <FrameLayout        android:orientation="horizontal"        android:layout_width="match_parent"        android:layout_height="wrap_content"        android:layout_marginLeft="10dp"        android:layout_marginRight="10dp">        <TextView            android:textSize="17dp"            android:textColor="@color/tab_text_normal_color"            android:layout_gravity="left"            android:layout_width="wrap_content"            android:layout_height="wrap_content"            android:text="@string/left_side_title" />        <TextView            android:textSize="17dp"            android:textColor="@color/tab_text_normal_color"            android:gravity="right"            android:layout_gravity="right"            android:layout_width="wrap_content"            android:layout_height="wrap_content"            android:text="@string/right_side_title" />    </FrameLayout>    <LinearLayout        android:layout_gravity="center_horizontal"        android:background="@drawable/element_position_bg"        android:paddingTop="10dp"        android:paddingBottom="10dp"        android:layout_width="match_parent"        android:layout_height="wrap_content"        android:layout_marginLeft="7dp"        android:layout_marginRight="7dp"        android:paddingStart="3dp"        android:paddingEnd="3dp">        <com.android.settings.statusbarelement.PositionsElementsStatusbarDouble            android:layout_width="match_parent"            android:layout_height="182dp" />    </LinearLayout>    <TextView        android:textSize="17dp"        android:textColor="@color/tab_text_normal_color"        android:layout_gravity="center_horizontal"        android:layout_width="wrap_content"        android:layout_height="wrap_content"        android:text="@string/center_tit1" /></LinearLayout>