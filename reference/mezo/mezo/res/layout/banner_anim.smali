<?xml version="1.0" encoding="utf-8"?><LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"    android:orientation="vertical"    android:background="#00000000"    android:layout_width="match_parent"    android:layout_height="80dp">    <LinearLayout        android:gravity="center"        android:orientation="horizontal"        android:layout_width="match_parent"        android:layout_height="match_parent">        <com.android.settings.ImageAnim            android:layout_width="match_parent"            android:layout_height="wrap_content"            android:src="@drawable/mezo_new_logo" />    </LinearLayout></LinearLayout>