<?xml version="1.0" encoding="utf-8"?><PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"    android:title="@string/incall_settings_title">    <XMiuiCheckBoxPreference        android:title="@string/full_call_window_tit"        android:key="full_call_window"        android:summary="@string/full_call_window_tit_summ"        android:defaultValue="false" />    <PreferenceCategory android:title="@string/colored_calls_cat">        <XMiuiCheckBoxPreference            android:title="@string/colored_calls_cat"            android:key="colored_mezo_names"            android:defaultValue="false"            android:summaryOn="@string/user_colors_contacts"            android:summaryOff="@string/user_colors_contacts_default"            intent="my.settings.intent.RESTART_CONTACTS" />        <XMiuiColorPickerPreference            android:title="@string/contact_mezo_color_title"            android:key="contact_mezo_color"            android:dependency="colored_mezo_names"            android:defaultValue="#00000000"            alphaSlider="true"            hexValue="true"            intent="my.settings.intent.RESTART_CONTACTS"            margin="1" />        <XMiuiColorPickerPreference            android:title="@string/incoming_mezo_color_title"            android:key="incoming_mezo_color"            android:dependency="colored_mezo_names"            android:defaultValue="#00000000"            alphaSlider="true"            hexValue="true"            intent="my.settings.intent.RESTART_CONTACTS"            margin="1" />        <XMiuiColorPickerPreference            android:title="@string/outgoing_mezo_color_title"            android:key="outgoing_mezo_color"            android:dependency="colored_mezo_names"            android:defaultValue="#00000000"            alphaSlider="true"            hexValue="true"            intent="my.settings.intent.RESTART_CONTACTS"            margin="1" />        <XMiuiColorPickerPreference            android:title="@string/missed_mezo_color_title"            android:key="missed_mezo_color"            android:dependency="colored_mezo_names"            android:defaultValue="#00000000"            alphaSlider="true"            hexValue="true"            intent="my.settings.intent.RESTART_CONTACTS"            margin="1" />        <XMiuiColorPickerPreference            android:title="@string/rejected_mezo_color_title"            android:key="rejected_mezo_color"            android:dependency="colored_mezo_names"            android:defaultValue="#00000000"            alphaSlider="true"            hexValue="true"            intent="my.settings.intent.RESTART_CONTACTS"            margin="1" />        <XMiuiColorPickerPreference            android:title="@string/voicemail_mezo_color_title"            android:key="voicemail_mezo_color"            android:dependency="colored_mezo_names"            android:defaultValue="#00000000"            alphaSlider="true"            hexValue="true"            intent="my.settings.intent.RESTART_CONTACTS"            margin="1" />    </PreferenceCategory></PreferenceScreen>