<?xml version="1.0" encoding="utf-8"?><PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"    android:title="@string/net_mezo_st_3">    <XMiuiColorPickerPreference        android:title="@string/net_mezo_st_4"        android:key="sim_one_color"        android:defaultValue="#00000000"        alphaSlider="true"        hexValue="true"        intent="my.settings.intent.sim_zoom.CHANGE" />    <XMiuiColorPickerPreference        android:title="@string/net_mezo_st_5"        android:key="sim_two_color"        android:defaultValue="#00000000"        alphaSlider="true"        hexValue="true"        intent="my.settings.intent.sim_zoom.CHANGE" />    <XMiuiColorPickerPreference        android:title="@string/net_mezo_st_6"        android:key="wifiview_color"        android:defaultValue="#00000000"        alphaSlider="true"        hexValue="true"        intent="my.settings.intent.wifiview_color.CHANGE" />    <XMiuiColorPickerPreference        android:title="@string/net_mezo_st_7"        android:key="airplaneview_color"        android:defaultValue="#00000000"        alphaSlider="true"        hexValue="true"        intent="my.settings.intent.airplaneview_color.CHANGE" />    <XMiuiColorPickerPreference        android:title="@string/net_mezo_st_8"        android:key="mobile_type_color"        android:defaultValue="#00000000"        alphaSlider="true"        hexValue="true"        intent="my.settings.intent.mobile_type_color.CHANGE" />    <XMiuiColorPickerPreference        android:title="@string/net_mezo_st_9"        android:key="mobile_inout_color"        android:defaultValue="#00000000"        alphaSlider="true"        hexValue="true"        intent="my.settings.intent.mobile_inout_color.CHANGE" />    <XMiuiColorPickerPreference        android:title="@string/net_mezo_st_10"        android:key="vpn_color"        android:defaultValue="#00000000"        alphaSlider="true"        hexValue="true"        intent="my.settings.intent.vpn_color.CHANGE" />    <XMiuiColorPickerPreference        android:title="@string/net_mezo_st_11"        android:key="vowifi_color"        android:defaultValue="#00000000"        alphaSlider="true"        hexValue="true"        intent="my.settings.intent.vowifi_color.CHANGE" />    <XMiuiColorPickerPreference        android:title="@string/net_mezo_st_12"        android:key="roam_color"        android:defaultValue="#00000000"        alphaSlider="true"        hexValue="true"        intent="my.settings.intent.roam_color.CHANGE" /></PreferenceScreen>