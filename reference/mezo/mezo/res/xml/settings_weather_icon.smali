<?xml version="1.0" encoding="utf-8"?><PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"    android:title="@string/weather_mezo_st_2">    <PreferenceCategory android:title="@string/weather_mezo_st_2">        <XMiuiCheckBoxPreference            android:title="@string/weather_mezo_st_3"            android:key="elem_weather_element_visible"            android:defaultValue="true"            intent="my.settings.intent.element_visibility_change.CHANGE" />        <XMiuiCheckBoxPreference            android:title="@string/weather_mezo_st_7"            android:key="weather_anim_enable"            android:defaultValue="false"            intent="my.settings.intent.weather_anim_enable.CHANGE" />        <XMiuiColorPickerPreference            android:title="@string/weather_mezo_st_5"            android:key="status_weather_color"            android:defaultValue="#00000000"            alphaSlider="true"            hexValue="true"            intent="my.settings.intent.status_weather_color.CHANGE" />        <EdSeekBarPreference            android:title="@string/weather_mezo_st_9"            android:key="status_weather_zoom"            android:defaultValue="16"            enableSummary="true"            intent="my.settings.intent.status_weather_color.CHANGE"            max="30"            min="1" />        <EdSeekBarPreference            android:title="@string/weather_mezo_st_8"            android:key="status_weather_division"            android:defaultValue="20"            enableSummary="true"            intent="my.settings.intent.status_weather_color.CHANGE"            max="30"            min="0" />        <MiuiFontStylePreference            android:title="@string/weather_mezo_st_6"            android:key="status_weather_typefase"            intent="my.settings.intent.status_weather_color.CHANGE" />    </PreferenceCategory></PreferenceScreen>