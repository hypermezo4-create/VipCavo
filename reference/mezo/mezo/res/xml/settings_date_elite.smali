<?xml version="1.0" encoding="utf-8"?><PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"    xmlns:app="http://schemas.android.com/apk/res-auto"    android:title="@string/date_mezo_st_2">    <PreferenceCategory android:title="@string/date_mezo_st_2">        <XMiuiCheckBoxPreference            android:title="@string/date_mezo_st_3"            android:key="elem_date_element_visible"            android:defaultValue="false"            intent="my.settings.intent.element_visibility_change.CHANGE" />        <XMiuiColorPickerPreference            android:title="@string/date_mezo_st_6"            android:key="status_date_color"            android:defaultValue="#00000000"            alphaSlider="true"            hexValue="true"            intent="my.settings.intent.status_date_color.CHANGE" />        <EdSeekBarPreference            android:title="@string/date_mezo_st_8"            android:key="status_date_zoom"            android:defaultValue="10"            enableSummary="true"            intent="my.settings.intent.status_date_color.CHANGE"            max="30"            min="1" />        <EdSeekBarPreference            android:title="@string/date_mezo_st_9"            android:key="status_date_division"            android:defaultValue="20"            enableSummary="true"            intent="my.settings.intent.status_date_color.CHANGE"            max="30"            min="0" />        <MiuiFontStylePreference            android:title="@string/date_mezo_st_7"            android:key="status_date_typefase"            intent="my.settings.intent.status_date_color.CHANGE" />        <XMiuiDropDownPreference            android:title="@string/date_mezo_st_5"            android:key="statusbar_date_format"            app:entries="@array/statusbar_date_format_entries"            app:entryIcons="@array/icon_date_menu"            app:entryValues="@array/statusbar_date_format_values"            intent="my.settings.intent.DATE_FORMAT_CHANGED" />    </PreferenceCategory></PreferenceScreen>