<?xml version="1.0" encoding="utf-8"?><PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"    xmlns:app="http://schemas.android.com/apk/res-auto"    android:title="@string/launcher_cust_title">    <XMiuiColorPickerPreference        android:title="@string/launcher_mezo_21"        android:key="color_desktop_icons"        android:defaultValue="#00000000"        intent="miui.intent.action.MIUI_REGION_CHANGED" />    <XMiuiCheckBoxPreference        android:title="@string/launcher_mezo_2"        android:key="endless_desktop"        android:defaultValue="false"        intent="miui.intent.action.MIUI_REGION_CHANGED" />    <XMiuiCheckBoxPreference        android:title="@string/launcher_mezo_3"        android:key="close_folder"        android:defaultValue="false" />    <XMiuiDropDownPreference        android:title="@string/launcher_mezo_nounlockanim_title"        android:key="disable_unlock_mezo_animation"        android:defaultValue="0"        app:entries="@array/disable_unlock_mezo_animation_ent"        app:entryValues="@array/disable_unlock_mezo_animation_val" />    <XMiuiCheckBoxPreference        android:title="@string/launcher_mezo_9"        android:key="lock_to_app_enabled"        android:defaultValue="false" />    <EdSeekBarPreference        android:title="@string/launcher_mezo_5"        android:key="app_anim_speed"        android:defaultValue="90"        max="180"        min="65" />    <EdSeekBarPreference        android:title="@string/launcher_mezo_4"        android:key="set_max_bar_icons"        android:defaultValue="5"        enableSummary="true"        intent="miui.intent.action.MIUI_REGION_CHANGED"        max="9"        min="1" /></PreferenceScreen>