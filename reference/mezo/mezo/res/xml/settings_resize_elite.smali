<?xml version="1.0" encoding="utf-8"?><PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto"    xmlns:android="http://schemas.android.com/apk/res/android"    android:title="@string/resize_mezo_st_2">    <StatusBarHeightPreference        android:title="@string/resize_mezo_st_3"        android:summary="@string/resize_mezo_st_4" />    <XMiuiCheckBoxPreference        android:title="@string/resize_mezo_st_17"        android:key="status_bar_elem_center_in_island"        android:defaultValue="true" />    <EdSeekBarPreference        android:title="@string/resize_mezo_st_8"        android:key="custom_status_bar_top"        android:defaultValue="2"        max="40"        min="0" />    <EdSeekBarPreference        android:title="@string/resize_mezo_st_7"        android:key="custom_status_bar_left_right"        android:defaultValue="0"        max="200"        min="0" />    <EdSeekBarPreference        android:title="@string/resize_mezo_st_6"        android:key="status_bar_element_cutout_padding"        android:defaultValue="35"        intent="my.settings.intent.element_position_cutout.CHANGE"        max="150"        min="0" />    <PreferenceCategory android:title="@string/resize_mezo_st_13" />    <XMiuiDropDownPreference        android:title="@string/resize_mezo_st_9"        android:key="status_bar_element_cutout_type"        android:defaultValue="1"        app:entries="@array/statusbar_cutout_type_entries"        app:entryValues="@array/statusbar_cutout_type_values"        intent="my.settings.intent.element_position_cutout.CHANGE" />    <XMiuiDropDownPreference        android:title="@string/resize_mezo_st_10"        android:key="status_bar_element_cutout_center"        android:defaultValue="2"        app:entries="@array/statusbar_cutout_center_entries"        app:entryValues="@array/statusbar_cutout_center_values"        intent="my.settings.intent.element_position_cutout.CHANGE" />    <EdSeekBarPreference        android:title="@string/resize_mezo_st_5"        android:key="status_bar_element_cutout_camera_width"        android:defaultValue="80"        intent="my.settings.intent.element_position_cutout.CHANGE"        max="200"        min="1" />    <PreferenceCategory android:title="@string/resize_mezo_st_14" />    <XMiuiDropDownPreference        android:title="@string/resize_mezo_st_11"        android:key="status_bar_element_cutout_left"        android:defaultValue="2"        app:entries="@array/statusbar_cutout_left_entries"        app:entryValues="@array/statusbar_cutout_left_values"        intent="my.settings.intent.element_position_cutout.CHANGE" />    <EdSeekBarPreference        android:title="@string/resize_mezo_st_15"        android:key="status_bar_element_cutout_padding_left_camera"        android:defaultValue="75"        intent="my.settings.intent.element_position_cutout.CHANGE"        max="150"        min="10" />    <XMiuiDropDownPreference        android:title="@string/resize_mezo_st_16"        android:key="status_bar_element_cutout_left_not_calculate"        android:defaultValue="2"        app:entries="@array/statusbar_cutout_left_not_calculate_entries"        app:entryValues="@array/statusbar_cutout_left_not_calculate_values"        intent="my.settings.intent.element_position_cutout.CHANGE" /></PreferenceScreen>