<?xml version="1.0" encoding="utf-8"?><PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"    android:title="@string/net_mezo_st_25">    <XMiuiCheckBoxPreference        android:title="@string/net_mezo_st_20"        android:key="elem_net_element_visible"        android:defaultValue="true"        intent="my.settings.intent.element_visibility_change.CHANGE" />    <XMiuiCheckBoxPreference        android:title="@string/net_mezo_st_21"        android:key="elem_wifi_element_visible"        android:defaultValue="true"        intent="my.settings.intent.element_visibility_change.CHANGE" />    <XMiuiCheckBoxPreference        android:title="@string/net_mezo_st_22"        android:key="vpn_visible"        android:defaultValue="true"        intent="my.settings.intent.vpn_color.CHANGE" />    <XMiuiCheckBoxPreference        android:title="@string/net_mezo_st_23"        android:key="vowifi_visible"        android:defaultValue="true"        intent="my.settings.intent.vowifi_color.CHANGE" />    <XMiuiCheckBoxPreference        android:title="@string/net_mezo_st_24"        android:key="roam_visible"        android:defaultValue="true"        intent="my.settings.intent.roam_color.CHANGE" /></PreferenceScreen>