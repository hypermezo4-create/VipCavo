<?xml version="1.0" encoding="utf-8"?><PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"    xmlns:app="http://schemas.android.com/apk/res-auto"    android:title="@string/netspeed_mezo_st_2">    <XMiuiDropDownPreference        android:title="@string/netspeed_mezo_st_6"        android:key="status_bar_show_network_speed"        android:defaultValue="1"        app:entries="@array/net_speed_entries"        app:entryValues="@array/net_speed_values" />    <EdSeekBarPreference        android:title="@string/netspeed_mezo_st_7"        android:key="net_speed_zoom"        android:defaultValue="12"        enableSummary="true"        intent="my.settings.intent.net_speed_color.CHANGE"        max="70"        min="1" />    <EdSeekBarPreference        android:title="@string/netspeed_mezo_st_8"        android:key="net_speed_division"        android:defaultValue="20"        enableSummary="true"        intent="my.settings.intent.net_speed_color.CHANGE"        max="30"        min="0" />    <EdSeekBarPreference        android:title="@string/netspeed_mezo_st_9"        android:key="net_speed_height"        android:defaultValue="50"        enableSummary="true"        intent="my.settings.intent.net_speed_color.CHANGE"        max="150"        min="30" />    <XMiuiColorPickerPreference        android:title="@string/netspeed_mezo_st_4"        android:key="net_speed_color"        android:defaultValue="#00000000"        alphaSlider="true"        hexValue="true"        intent="my.settings.intent.net_speed_color.CHANGE" />    <EdSeekBarPreference        android:title="@string/netspeed_mezo_st_10"        android:key="status_bar_network_speed_interval"        android:defaultValue="1000"        enableSummary="true"        max="4000"        min="500"        step="500" />    <MiuiFontStylePreference        android:title="@string/netspeed_mezo_st_5"        android:key="net_speed_typefase"        intent="my.settings.intent.net_speed_color.CHANGE" /></PreferenceScreen>