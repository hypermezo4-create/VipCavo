<?xml version="1.0" encoding="utf-8"?><PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"    xmlns:app="http://schemas.android.com/apk/res-auto"    android:title="@string/clock_cust">    <PreferenceCategory android:title="@string/clock_notif_hdr_16">        <XMiuiCheckBoxPreference            android:title="@string/clock_mezo_set_0"            android:key="elem_clock_element_visible"            android:defaultValue="true"            intent="my.settings.intent.element_visibility_change.CHANGE" />        <EdSeekBarPreference            android:title="@string/clock_mezo_set_10"            android:key="status_clock_zoom"            android:defaultValue="14"            enableSummary="true"            max="30"            min="0" />        <EdSeekBarPreference            android:title="@string/clock_mezo_set_11"            android:key="status_clock_division"            android:defaultValue="20"            enableSummary="true"            max="30"            min="0" />        <XMiuiColorPickerPreference            android:title="@string/clock_mezo_set_1"            android:key="status_clock_color"            android:defaultValue="#00000000"            alphaSlider="true"            hexValue="true" />        <MiuiFontStylePreference            android:title="@string/clock_mezo_set_2"            android:key="status_clock_typefase"            intent="my.settings.intent.CLOCK_TYPEFACE_CHANGE" />        <XMiuiDropDownPreference            android:title="@string/clock_mezo_set_6"            android:key="status_clock_anim_style"            android:defaultValue="1"            app:entries="@array/clock_anim_time"            app:entryValues="@array/clock_anim_time_values"            intent="my.intent.action.REFRESH_STATUSBAR" />        <XMiuiCheckBoxPreference            android:title="@string/clock_mezo_set_3"            android:key="status_clock_dots_enable"            android:defaultValue="true"            android:summaryOn="@string/clock_mezo_set_4"            android:summaryOff="@string/clock_mezo_set_5"            intent="my.intent.action.REFRESH_STATUSBAR" />        <XMiuiCheckBoxPreference            android:title="@string/clock_mezo_set_7"            android:key="status_clock_second_enable"            android:defaultValue="true"            android:summaryOn="@string/clock_mezo_set_4"            android:summaryOff="@string/clock_mezo_set_5" />        <XMiuiCheckBoxPreference            android:title="@string/clock_mezo_set_9"            android:key="clock_mezo_time_style"            android:defaultValue="false"            intent="my.intent.action.REFRESH_STATUSBAR" />    </PreferenceCategory>    <PreferenceCategory android:title="@string/clock_notif_hdr_1">        <EdSeekBarPreference            android:title="@string/clock_notif_hdr_2"            android:key="expanded_clock_zoom"            android:defaultValue="50"            enableSummary="true"            max="100"            min="1" />        <EdSeekBarPreference            android:title="@string/clock_notif_hdr_3"            android:key="expanded_clock_division"            android:defaultValue="15"            enableSummary="true"            max="30"            min="10" />        <XMiuiColorPickerPreference            android:title="@string/clock_notif_hdr_4"            android:key="expanded_clock_color"            alphaSlider="true"            hexValue="true" />        <XMiuiCheckBoxPreference            android:title="@string/clock_notif_hdr_5"            android:key="expanded_clock_dots_enable"            android:defaultValue="false"            android:summaryOn="@string/clock_notif_hdr_6"            android:summaryOff="@string/clock_notif_hdr_7" />        <XMiuiDropDownPreference            android:title="@string/clock_notif_hdr_8"            android:key="expanded_clock_anim_style"            android:defaultValue="0"            app:entries="@array/clock_anim_time"            app:entryValues="@array/clock_anim_time_values" />        <XMiuiCheckBoxPreference            android:title="@string/clock_notif_hdr_9"            android:key="expanded_clock_second_enable"            android:defaultValue="false"            android:summaryOn="@string/clock_notif_hdr_6"            android:summaryOff="@string/clock_notif_hdr_7" />    </PreferenceCategory>    <PreferenceCategory android:title="@string/clock_notif_hdr_12">        <EdSeekBarPreference            android:title="@string/clock_notif_hdr_2"            android:key="Notif_date_zoom"            android:defaultValue="18"            intent="my.settings.intent.Notif_date_color.CHANGE"            max="70"            min="1" />        <EdSeekBarPreference            android:title="@string/clock_notif_hdr_3"            android:key="Notif_date_division"            android:defaultValue="15"            intent="my.settings.intent.Notif_date_color.CHANGE"            max="50"            min="10" />        <XMiuiColorPickerPreference            android:title="@string/clock_notif_hdr_4"            android:key="Notif_date_color"            alphaSlider="true"            hexValue="true"            intent="my.settings.intent.Notif_date_color.CHANGE" />        <MiuiFontStylePreference            android:title="@string/clock_notif_hdr_11"            android:key="Notif_date_typefase"            intent="my.settings.intent.Notif_date_color.CHANGE" />        <XMiuiDropDownPreference            android:title="@string/clock_notif_hdr_13"            android:key="Notif_date_format"            android:defaultValue="0"            app:entries="@array/statusbar_date_format_entries"            app:entryIcons="@array/icon_date_menu"            app:entryValues="@array/statusbar_date_format_values"            intent="my.settings.intent.DATE_FORMAT_CHANGED" />    </PreferenceCategory>    <PreferenceCategory android:title="@string/clock_notif_hdr_10">        <EdSeekBarPreference            android:title="@string/clock_notif_hdr_2"            android:key="weather_notif_text_zoom"            android:defaultValue="16"            intent="my.settings.intent.weather_notif_text_color.CHANGE"            max="20"            min="5" />        <XMiuiColorPickerPreference            android:title="@string/clock_notif_hdr_4"            android:key="weather_notif_text_color"            android:defaultValue="#00000000"            alphaSlider="true"            hexValue="true"            intent="my.settings.intent.weather_notif_text_color.CHANGE" />        <MiuiFontStylePreference            android:title="@string/clock_notif_hdr_11"            android:key="weather_notif_text_typefase"            intent="my.settings.intent.weather_notif_text_color.CHANGE" />    </PreferenceCategory>    <PreferenceCategory android:title="@string/clock_notif_hdr_14">        <XMiuiColorPickerPreference            android:title="@string/clock_notif_hdr_4"            android:key="Settingsfachen_color"            alphaSlider="true"            hexValue="true"            intent="my.settings.intent.Settingsfachen_color.CHANGE" />        <EdSeekBarPreference            android:title="@string/clock_notif_hdr_2"            android:key="Settingsfachen_zoom"            android:defaultValue="130"            intent="my.settings.intent.Settingsfachen_color.CHANGE"            max="200"            min="50" />        <EdSeekBarPreference            android:title="@string/clock_notif_hdr_15"            android:key="Settingsfachen_scale"            android:defaultValue="100"            intent="my.settings.intent.Settingsfachen_color.CHANGE"            max="200"            min="50" />        <EdSeekBarPreference            android:title="@string/clock_notif_hdr_3"            android:key="Settingsfachen_division"            android:defaultValue="0"            intent="my.settings.intent.Settingsfachen_color.CHANGE"            max="50"            min="-50" />    </PreferenceCategory></PreferenceScreen>