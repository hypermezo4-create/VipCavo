<?xml version="1.0" encoding="utf-8"?><PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"    android:title="@string/status_mezo_st_2">    <PreferenceCategory android:title="@string/status_mezo_st_2">        <XMiuiCheckBoxPreference            android:title="@string/status_mezo_st_3"            android:key="elem_status_element_visible"            android:defaultValue="true"            intent="my.settings.intent.element_visibility_change.CHANGE" />        <XMiuiColorPickerPreference            android:title="@string/status_mezo_st_5"            android:key="status_icon_color"            android:defaultValue="#00000000"            alphaSlider="true"            hexValue="true"            intent="my.settings.intent.status_icon_color.CHANGE" />        <EdSeekBarPreference            android:title="@string/status_mezo_st_11"            android:key="status_icon_zoom"            android:defaultValue="100"            enableSummary="true"            intent="my.settings.intent.status_icon_color.CHANGE"            max="200"            min="50" />        <EdSeekBarPreference            android:title="@string/status_mezo_st_12"            android:key="status_icon_scale"            android:defaultValue="100"            enableSummary="true"            intent="my.settings.intent.status_icon_color.CHANGE"            max="150"            min="50" />        <EdSeekBarPreference            android:title="@string/status_mezo_st_13"            android:key="status_icon_division"            android:defaultValue="0"            enableSummary="true"            intent="my.settings.intent.status_icon_color.CHANGE"            max="50"            min="-50" />    </PreferenceCategory></PreferenceScreen>