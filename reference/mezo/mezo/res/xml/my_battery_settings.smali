<?xml version="1.0" encoding="utf-8"?><PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"    xmlns:app="http://schemas.android.com/apk/res-auto"    android:title="@string/battery_mezoset_3">    <PreferenceCategory android:title="@string/battery_mezoset_2">        <XMiuiCheckBoxPreference            android:title="@string/battery_mezoset_21"            android:key="elem_bat_element_visible"            android:defaultValue="true"            intent="my.settings.intent.element_visibility_change.CHANGE" />        <XMiuiDropDownPreference            android:title="@string/battery_mezoset_4"            android:key="battery_indicator_style"            android:defaultValue="1"            app:entries="@array/battery_indicator_style_entries2"            app:entryIcons="@array/battery_indicator_style_icons2"            app:entryValues="@array/battery_indicator_style_values2" />        <XMiuiDropDownPreference            android:title="@string/battery_mezoset_16"            android:key="use_legacy_drawable"            android:defaultValue="0"            app:entries="@array/battery_icon_entries"            app:entryValues="@array/battery_icon_values"            intent="my.settings.intent.use_legacy_drawable.CHANGE" />        <com.android.settingslib.miuisettings.preference.Preference            android:title="@string/battery_mezoset_30"            android:key="android.theme.customization.battery_icon"            android:summary="@string/battery_mezoset_31"            android:fragment="mobx.settings.overlay.icon.battery.BatteryIcons" />    </PreferenceCategory>    <PreferenceCategory android:title="@string/battery_mezoset_5" />    <XMiuiSeekBarPreference        android:title="@string/battery_mezoset_22"        android:key="batteryview_zoom"        android:defaultValue="100"        enableSummary="true"        intent="my.settings.intent.batteryview_zoom.CHANGE"        max="150"        min="50" />    <XMiuiSeekBarPreference        android:title="@string/battery_mezoset_23"        android:key="batteryview_scale"        android:defaultValue="100"        enableSummary="true"        intent="my.settings.intent.batteryview_zoom.CHANGE"        max="200"        min="50" />    <XMiuiSeekBarPreference        android:title="@string/battery_mezoset_24"        android:key="batteryview_division"        android:defaultValue="0"        enableSummary="true"        intent="my.settings.intent.batteryview_zoom.CHANGE"        max="50"        min="-50" />    <PreferenceCategory android:title="@string/battery_mezoset_7" />    <XMiuiSeekBarPreference        android:title="@string/battery_mezoset_22"        android:key="battery_percent_zoom"        android:defaultValue="14"        enableSummary="true"        intent="my.settings.intent.battery_percent_zoom.CHANGE"        max="30"        min="1" />    <XMiuiSeekBarPreference        android:title="@string/battery_mezoset_24"        android:key="battery_percent_division"        android:defaultValue="20"        enableSummary="true"        intent="my.settings.intent.battery_percent_zoom.CHANGE"        max="30"        min="0" />    <PreferenceCategory android:title="@string/battery_mezoset_8" />    <XMiuiSeekBarPreference        android:title="@string/battery_mezoset_22"        android:key="battery_charge_zoom"        android:defaultValue="100"        enableSummary="true"        intent="my.settings.intent.battery_charge_color.CHANGE"        max="150"        min="50" />    <XMiuiSeekBarPreference        android:title="@string/battery_mezoset_23"        android:key="battery_charge_scale"        android:defaultValue="100"        enableSummary="true"        intent="my.settings.intent.battery_charge_color.CHANGE"        max="150"        min="50" />    <XMiuiSeekBarPreference        android:title="@string/battery_mezoset_24"        android:key="battery_charge_division"        android:defaultValue="0"        enableSummary="true"        intent="my.settings.intent.battery_charge_color.CHANGE"        max="50"        min="-50" />    <PreferenceCategory android:title="@string/battery_mezoset_9" />    <XMiuiSeekBarPreference        android:title="@string/battery_mezoset_22"        android:key="battery_percent_digit_zoom"        android:defaultValue="24"        enableSummary="true"        intent="my.settings.intent.battery_percent_digit_color.CHANGE"        max="50"        min="1" />    <XMiuiSeekBarPreference        android:title="@string/battery_mezoset_24"        android:key="battery_percent_digit_division"        android:defaultValue="20"        enableSummary="true"        intent="my.settings.intent.battery_percent_digit_color.CHANGE"        max="30"        min="0" />    <PreferenceCategory android:title="@string/battery_mezoset_10" />    <XMiuiColorPickerPreference        android:title="@string/text_bat_color_0_title"        android:key="text_bat_color_0"        android:defaultValue="#00000000"        alphaSlider="true"        hexValue="true"        intent="my.settings.intent.text_bat_color.CHANGE" />    <XMiuiColorPickerPreference        android:title="@string/text_bat_color_1_title"        android:key="text_bat_color_1"        android:defaultValue="#00000000"        alphaSlider="true"        hexValue="true"        intent="my.settings.intent.text_bat_color.CHANGE" />    <XMiuiColorPickerPreference        android:title="@string/text_bat_color_2_title"        android:key="text_bat_color_2"        android:defaultValue="#00000000"        alphaSlider="true"        hexValue="true"        intent="my.settings.intent.text_bat_color.CHANGE" />    <XMiuiColorPickerPreference        android:title="@string/text_bat_color_3_title"        android:key="text_bat_color_3"        android:defaultValue="#00000000"        alphaSlider="true"        hexValue="true"        intent="my.settings.intent.text_bat_color.CHANGE" />    <XMiuiColorPickerPreference        android:title="@string/text_bat_color_4_title"        android:key="text_bat_color_4"        android:defaultValue="#00000000"        alphaSlider="true"        hexValue="true"        intent="my.settings.intent.text_bat_color.CHANGE" />    <XMiuiColorPickerPreference        android:title="@string/battery_mezoset_13"        android:key="battery_percent_digit_color"        android:defaultValue="#00000000"        alphaSlider="true"        hexValue="true"        intent="my.settings.intent.battery_percent_digit_color.CHANGE" />    <XMiuiColorPickerPreference        android:title="@string/battery_mezoset_14"        android:key="battery_charge_color"        android:defaultValue="#00000000"        alphaSlider="true"        hexValue="true"        intent="my.settings.intent.battery_charge_color.CHANGE" />    <PreferenceCategory android:title="@string/battery_mezoset_15" />    <MiuiFontStylePreference        android:title="@string/battery_mezoset_26"        android:key="battery_percent_typefase"        intent="my.settings.intent.battery_percent_zoom.CHANGE" />    <XMiuiCheckBoxPreference        android:title="@string/battery_mezoset_27"        android:key="battery_percent_mark_enable"        android:defaultValue="true"        intent="my.settings.intent.battery_percent_mark_enable.CHANGE" />    <PreferenceCategory android:title="@string/battery_mezoset_28" />    <XMiuiCheckBoxPreference        android:title="@string/battery_mezoset_25"        android:key="battery_percent_mark_settings_enable"        android:defaultValue="false" />    <MiuiFontStylePreference        android:title="@string/battery_mezoset_11"        android:key="battery_percent_mark_typefase"        android:dependency="battery_percent_mark_settings_enable" />    <PreferenceCategory        android:title="@string/battery_mezoset_29"        android:dependency="battery_percent_mark_settings_enable" />    <XMiuiColorPickerPreference        android:title="@string/text_bat_color_0_title"        android:key="text_bat_color_mark_0"        android:dependency="battery_percent_mark_settings_enable"        android:defaultValue="#00000000"        alphaSlider="true"        hexValue="true" />    <XMiuiColorPickerPreference        android:title="@string/text_bat_color_1_title"        android:key="text_bat_color_mark_1"        android:dependency="battery_percent_mark_settings_enable"        android:defaultValue="#00000000"        alphaSlider="true"        hexValue="true" />    <XMiuiColorPickerPreference        android:title="@string/text_bat_color_2_title"        android:key="text_bat_color_mark_2"        android:dependency="battery_percent_mark_settings_enable"        android:defaultValue="#00000000"        alphaSlider="true"        hexValue="true" />    <XMiuiColorPickerPreference        android:title="@string/text_bat_color_3_title"        android:key="text_bat_color_mark_3"        android:dependency="battery_percent_mark_settings_enable"        android:defaultValue="#00000000"        alphaSlider="true"        hexValue="true" />    <XMiuiColorPickerPreference        android:title="@string/text_bat_color_4_title"        android:key="text_bat_color_mark_4"        android:dependency="battery_percent_mark_settings_enable"        android:defaultValue="#00000000"        alphaSlider="true"        hexValue="true" />    <XMiuiSeekBarPreference        android:title="@string/battery_mezoset_22"        android:key="battery_percent_mark_zoom"        android:dependency="battery_percent_mark_settings_enable"        android:defaultValue="14"        enableSummary="true"        max="30"        min="1" />    <XMiuiSeekBarPreference        android:title="@string/battery_mezoset_24"        android:key="battery_percent_mark_division"        android:dependency="battery_percent_mark_settings_enable"        android:defaultValue="20"        enableSummary="true"        max="30"        min="10" /></PreferenceScreen>