<?xml version="1.0" encoding="utf-8"?><PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"    xmlns:app="http://schemas.android.com/apk/res/com.android.settings"    android:title="@string/menu_mezo_st_0">    <PreferenceCategory android:title="@string/menu_mezo_st_2">        <XMiuiDropDownPreference            android:title="@string/menu_mezo_st_3"            android:key="mezo_development_settings_index"            android:defaultValue="2"            app:entries="@array/mezo_development_settings_index_entries"            app:entryIcons="@array/mezo_development_settings_index_icons"            app:entryValues="@array/mezo_development_settings_index_values"            intent="my.intent.action.REFRESH_STATUSBAR" />        <EdSeekBarPreference            android:title="@string/menu_mezo_st_5"            android:key="card_bg_stroke_width"            android:defaultValue="1"            intent="my.intent.action.REFRESH_STATUSBAR"            max="10"            min="0" />        <XMiuiColorPickerPreference            android:title="@string/menu_mezo_st_6"            android:key="card_bg_stroke_color"            android:defaultValue="#ff00ff00"            alphaSlider="true"            hexValue="true"            intent="my.intent.action.REFRESH_STATUSBAR" />        <XMiuiColorPickerPreference            android:title="@string/menu_mezo_st_7"            android:key="card_bg_stroke_color_dark"            android:defaultValue="#ff00ff00"            alphaSlider="true"            hexValue="true"            intent="my.intent.action.REFRESH_STATUSBAR" />    </PreferenceCategory>    <PreferenceCategory android:title="@string/menu_clr_mezo_99">        <XMiuiColorPickerPreference            android:title="@string/menu_clr_mezo_0"            android:key="preference_seekbar_progress_color"            android:defaultValue="#ff9c7fe6"            intent="my.settings.intent.preference_color_update.CHANGE" />        <XMiuiColorPickerPreference            android:title="@string/menu_clr_mezo_3"            android:key="preference_sliding_on_bg_color"            android:defaultValue="#ff00ffaf"            intent="my.settings.intent.preference_color_update.CHANGE" />        <XMiuiColorPickerPreference            android:title="@string/menu_clr_mezo_4"            android:key="preference_sliding_off_bg_color"            android:defaultValue="#00000000"            intent="my.settings.intent.preference_color_update.CHANGE" />        <XMiuiColorPickerPreference            android:title="@string/menu_clr_mezo_1"            android:key="preference_sliding_on_color"            android:defaultValue="#00000000"            intent="my.settings.intent.preference_color_update.CHANGE" />        <XMiuiColorPickerPreference            android:title="@string/menu_clr_mezo_2"            android:key="preference_sliding_off_color"            android:defaultValue="#00000000"            intent="my.settings.intent.preference_color_update.CHANGE" />    </PreferenceCategory></PreferenceScreen>