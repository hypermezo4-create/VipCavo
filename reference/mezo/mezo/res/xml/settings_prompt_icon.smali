<?xml version="1.0" encoding="utf-8"?><PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"    android:title="@string/prompt_mezo_st_0">    <EdSeekBarPreference        android:title="@string/prompt_mezo_st_2"        android:key="elem_prompt_scale"        android:defaultValue="75"        enableSummary="true"        intent="my.settings.intent.elem_prompt_color.CHANGE"        max="150"        min="50" />    <EdSeekBarPreference        android:title="@string/prompt_mezo_st_3"        android:key="elem_prompt_division"        android:defaultValue="0"        enableSummary="true"        intent="my.settings.intent.elem_prompt_color.CHANGE"        max="50"        min="-50" /></PreferenceScreen>