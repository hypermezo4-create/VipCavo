<?xml version="1.0" encoding="utf-8"?><PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"    android:title="@string/net_mezo_st_11">    <EdSeekBarPreference        android:title="@string/net_mezo_st_27"        android:key="vowifi_zoom"        android:defaultValue="100"        enableSummary="true"        intent="my.settings.intent.vowifi_color.CHANGE"        max="200"        min="50" />    <EdSeekBarPreference        android:title="@string/net_mezo_st_28"        android:key="vowifi_scale"        android:defaultValue="100"        enableSummary="true"        intent="my.settings.intent.vowifi_color.CHANGE"        max="200"        min="50" />    <EdSeekBarPreference        android:title="@string/net_mezo_st_29"        android:key="vowifi_division"        android:defaultValue="0"        enableSummary="true"        intent="my.settings.intent.vowifi_color.CHANGE"        max="50"        min="-50" /></PreferenceScreen>