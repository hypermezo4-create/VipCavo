<?xml version="1.0" encoding="utf-8"?><PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"    xmlns:app="http://schemas.android.com/apk/res-auto"    android:title="@string/mezo_notif_anim_1">    <PreferenceCategory android:title="@string/mezo_notif_anim_19" />    <XMiuiCheckBoxPreference        android:title="@string/mezo_notif_anim_2"        android:key="anim_expand_enable"        android:defaultValue="false"        intent="com.android.settings.NotifColorSett" />    <XMiuiListPreference        android:entries="@array/anim_expand_name"        android:title="@string/mezo_notif_anim_3"        android:key="anim_expand_style"        android:summary="%s"        android:dependency="anim_expand_enable"        android:defaultValue="5"        android:entryValues="@array/anim_expand_style"        intent="com.android.settings.NotifColorSett" />    <XMiuiDropDownPreference        android:title="@string/mezo_notif_anim_21"        android:key="loopanim"        android:dependency="anim_expand_enable"        android:defaultValue="3"        app:entries="@array/loopanim_name"        app:entryValues="@array/loopanim_values" />    <XMiuiListPreference        android:entries="@array/notif_interpolator_entries"        android:title="@string/mezo_notif_anim_4"        android:key="anim_expand_interpolator"        android:summary="%s"        android:dependency="anim_expand_enable"        android:defaultValue="5"        android:entryValues="@array/notif_interpolator_values"        intent="com.android.settings.NotifColorSett" />    <EdSeekBarPreference        android:title="@string/mezo_notif_anim_5"        android:key="anim_expand_duration"        android:dependency="anim_expand_enable"        android:defaultValue="1000"        intent="my.settings.intent.notif_expanded_header.CHANGE"        max="2000"        min="600" />    <PreferenceCategory android:title="@string/mezo_notif_anim_20" />    <XMiuiCheckBoxPreference        android:title="@string/mezo_notif_anim_2"        android:key="anim_expand_enable2"        android:defaultValue="false"        intent="com.android.settings.NotifColorSett" />    <XMiuiListPreference        android:entries="@array/anim_expand_name2"        android:title="@string/mezo_notif_anim_3"        android:key="anim_expand_style2"        android:summary="%s"        android:dependency="anim_expand_enable2"        android:defaultValue="4"        android:entryValues="@array/anim_expand_style2"        intent="com.android.settings.NotifColorSett" />    <XMiuiDropDownPreference        android:title="@string/mezo_notif_anim_21"        android:key="loopanim2"        android:dependency="anim_expand_enable2"        android:defaultValue="3"        app:entries="@array/loopanim_name2"        app:entryValues="@array/loopanim_values2" />    <XMiuiListPreference        android:entries="@array/notif_interpolator_entries"        android:title="@string/mezo_notif_anim_4"        android:key="anim_expand_interpolator2"        android:summary="%s"        android:dependency="anim_expand_enable2"        android:defaultValue="5"        android:entryValues="@array/notif_interpolator_values"        intent="com.android.settings.NotifColorSett" />    <EdSeekBarPreference        android:title="@string/mezo_notif_anim_5"        android:key="anim_expand_duration2"        android:dependency="anim_expand_enable2"        android:defaultValue="1000"        intent="my.settings.intent.notif_expanded_header.CHANGE"        max="2000"        min="600" /></PreferenceScreen>