<?xml version="1.0" encoding="utf-8"?><PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"    xmlns:app="http://schemas.android.com/apk/res-auto"    android:title="@string/control_center13_summ">    <MyXCheckBoxPreference        android:title="@string/restart_sisui_tit_2"        android:summary="@string/restart_sisui_tit_summ_2"        intent="my.intent.action.REFRESH_SYSTEMUI" />    <XMiuiCheckBoxPreference        android:title="@string/square_tiles_title"        android:key="square_mezo_tiles"        android:defaultValue="true"        android:summaryOn="@string/square_tiles_on"        android:summaryOff="@string/square_tiles_off"        intent="my.intent.action.REFRESH_STATUSBAR" />    <XMiuiListPreference        android:entries="@array/cc_style_entries"        android:title="@string/mezo_cc_style_tit"        android:key="swap_tiles_1"        android:summary="%s"        android:defaultValue="0"        android:entryValues="@array/cc_style_values"        intent="my.intent.action.REFRESH_STATUSBAR" />    <XMiuiTileGridPreference        android:title="@string/control_center13_new_1"        android:key="extra_two_mezo_tiles"        android:defaultValue="wifi,cell"        app:widgetLayout="@layout/pref_tile_grid" />    <EdSeekBarPreference        android:title="@string/cc_blur_title"        android:key="cc_blur_ratio"        android:defaultValue="100" /></PreferenceScreen>