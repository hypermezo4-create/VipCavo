<?xml version="1.0" encoding="utf-8"?><PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"    android:title="@string/notif_mezo_st_2">    <PreferenceCategory android:title="@string/notif_mezo_st_2">        <XMiuiCheckBoxPreference            android:title="@string/notif_mezo_st_10"            android:key="reverse_notification_sorting_order"            android:defaultValue="false"            android:summaryOn="@string/check_on2"            android:summaryOff="@string/check_off2"            intent="my.settings.intent.notif_icon_color.CHANGE" />        <XMiuiColorPickerPreference            android:title="@string/notif_mezo_st_5"            android:key="notif_icon_color"            android:defaultValue="#00000000"            alphaSlider="true"            hexValue="true"            intent="my.settings.intent.notif_icon_color.CHANGE" />        <EdSeekBarPreference            android:title="@string/notif_mezo_st_7"            android:key="notif_icon_zoom"            android:defaultValue="100"            enableSummary="true"            intent="my.settings.intent.notif_icon_color.CHANGE"            max="150"            min="10" />        <EdSeekBarPreference            android:title="@string/notif_mezo_st_8"            android:key="notif_icon_scale"            android:defaultValue="100"            enableSummary="true"            intent="my.settings.intent.notif_icon_color.CHANGE"            max="150"            min="0" />        <EdSeekBarPreference            android:title="@string/notif_mezo_st_9"            android:key="notif_icon_division"            android:defaultValue="0"            enableSummary="true"            intent="my.settings.intent.notif_icon_color.CHANGE"            max="50"            min="-50" />    </PreferenceCategory></PreferenceScreen>