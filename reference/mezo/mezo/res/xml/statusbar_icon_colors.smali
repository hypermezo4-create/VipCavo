<?xml version="1.0" encoding="utf-8"?><PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"    android:title="@string/net_mezo_st_2">    <PreferenceCategory android:title="@string/net_mezo_st_31">        <com.android.settingslib.miuisettings.preference.Preference            android:title="@string/net_mezo_st_25"            android:key="mezo_net_frag_2"            android:fragment="com.android.settings.mezoFragment2" />        <com.android.settingslib.miuisettings.preference.Preference            android:title="@string/net_mezo_st_3"            android:key="mezo_net_frag_1"            android:fragment="com.android.settings.mezoFragment1" />        <com.android.settingslib.miuisettings.preference.Preference            android:title="@string/net_mezo_st_33"            android:key="android.theme.customization.signal_icon"            android:fragment="mobx.settings.overlay.icon.signal.SignalIcons" />        <com.android.settingslib.miuisettings.preference.Preference            android:title="@string/net_mezo_st_32"            android:key="android.theme.customization.wifi_icon"            android:fragment="mobx.settings.overlay.icon.wifi.WifiIcons" />        <com.android.settingslib.miuisettings.preference.Preference            android:title="@string/net_mezo_st_34"            android:key="android.theme.customization.vowifi_icon"            android:fragment="mobx.settings.overlay.icon.vowifi.VowifiIcons" />        <com.android.settingslib.miuisettings.preference.Preference            android:title="@string/net_mezo_st_35"            android:key="android.theme.customization.volte_icon"            android:fragment="mobx.settings.overlay.icon.volte.VolteIcons" />    </PreferenceCategory>    <PreferenceCategory android:title="@string/net_mezo_st_13">        <MiuiMiniPreferenceScreen            android:title="@string/net_mezo_st_14"            xmlName="elem_net_mezo" />        <MiuiMiniPreferenceScreen            android:title="@string/net_mezo_st_15"            xmlName="elem_wifi_mezo" />        <MiuiMiniPreferenceScreen            android:title="@string/net_mezo_st_10"            xmlName="elem_volte_mezo" />        <MiuiMiniPreferenceScreen            android:title="@string/net_mezo_st_11"            xmlName="elem_vowifi_mezo" />        <MiuiMiniPreferenceScreen            android:title="@string/net_mezo_st_12"            xmlName="elem_roam_mezo" />    </PreferenceCategory>    <PreferenceCategory android:title="@string/net_mezo_st_16">        <MiuiFontStylePreference            android:title="@string/net_mezo_st_8"            android:key="mobile_type_typefase"            intent="my.settings.intent.mobile_type_color.CHANGE" />    </PreferenceCategory>    <PreferenceCategory android:title="@string/net_mezo_st_17">        <XMiuiCheckBoxPreference            android:title="@string/net_mezo_st_4"            android:key="elem_net1_rotate"            android:defaultValue="true"            intent="my.settings.intent.elem_net1_rotate.CHANGE" />        <XMiuiCheckBoxPreference            android:title="@string/net_mezo_st_5"            android:key="elem_net2_rotate"            android:defaultValue="false"            intent="my.settings.intent.elem_net2_rotate.CHANGE" />        <XMiuiCheckBoxPreference            android:title="@string/net_mezo_st_18"            android:key="sim_type_position"            android:defaultValue="true" />        <EdSeekBarPreference            android:title="@string/net_mezo_st_30"            android:key="sim_type_margin"            android:defaultValue="-20"            enableSummary="true"            max="50"            min="-100" />    </PreferenceCategory></PreferenceScreen>