<?xml version="1.0" encoding="utf-8"?><LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"    xmlns:app="http://schemas.android.com/apk/res-auto"    android:orientation="horizontal"    android:id="@01020299"    android:paddingTop="12dp"    android:paddingBottom="17dp"    android:clipToPadding="false"    android:layout_width="match_parent"    android:layout_height="wrap_content"    android:minHeight="?android:attr/listPreferredItemHeight"    android:paddingHorizontal="16dp">    <FrameLayout        android:layout_gravity="center_vertical"        android:id="@android:id/icon_frame"        android:layout_width="wrap_content"        android:layout_height="wrap_content"        android:layout_marginEnd="10dp">        <androidx.preference.internal.PreferenceImageView            android:id="@android:id/icon"            android:padding="1.5dp"            android:layout_width="24dp"            android:layout_height="24dp"            app:maxHeight="52.500008dp"            app:maxWidth="52.500008dp" />    </FrameLayout>    <LinearLayout        android:orientation="vertical"        android:layout_width="0dp"        android:layout_height="wrap_content"        android:layout_weight="1.0">        <LinearLayout            android:gravity="center_vertical"            android:orientation="horizontal"            android:layout_width="match_parent"            android:layout_height="wrap_content"            android:layout_marginBottom="7dp">            <TextView                android:textAppearance="@style/Miuix.AppCompat.TextAppearance.PreferenceList"                android:textColor="@color/preference_primary_text_color"                android:ellipsize="marquee"                android:id="@android:id/title"                android:layout_width="0dp"                android:layout_height="wrap_content"                android:scrollHorizontally="true"                android:singleLine="true"                android:layout_weight="1.0"                android:marqueeRepeatLimit="marquee_forever" />            <TextView                android:textSize="12sp"                android:textColor="#FF000000"                android:id="@android:id/text1"                android:background="@drawable/ed_seekbar_reset_background"                android:layout_width="wrap_content"                android:layout_height="wrap_content"                android:text="RESET"                android:maxLines="1"                android:includeFontPadding="false"                android:layout_marginEnd="8dp"                android:paddingHorizontal="5dp"                android:paddingVertical="2dp" />            <TextView                android:textAppearance="@style/Miuix.AppCompat.TextAppearance.PreferenceList"                android:textColor="?android:attr/textColorPrimary"                android:id="@android:id/summary"                android:layout_width="wrap_content"                android:layout_height="wrap_content" />        </LinearLayout>        <LinearLayout            android:gravity="center_vertical"            android:orientation="horizontal"            android:layout_width="match_parent"            android:layout_height="wrap_content">            <ImageView                android:id="@android:id/undo"                android:layout_width="wrap_content"                android:layout_height="27dp"                android:src="@drawable/ic_ed_seekbar_minus"                android:scaleType="centerCrop"                android:layout_marginEnd="7dp" />            <androidx.preferencecolor.PreferenceSeekBar                android:id="@android:id/progress"                android:layout_width="0dp"                android:layout_height="wrap_content"                android:layout_weight="1.0"                style="?attr/seekBarPreferenceInternalTheme" />            <ImageView                android:id="@android:id/redo"                android:layout_width="wrap_content"                android:layout_height="27dp"                android:src="@drawable/ic_ed_seekbar_plus"                android:scaleType="centerCrop"                android:layout_marginStart="7dp" />        </LinearLayout>    </LinearLayout></LinearLayout>