<?xml version="1.0" encoding="utf-8"?><miuix.smooth.MySmoothContainerDrawable xmlns:android="http://schemas.android.com/apk/res/android"    android:topLeftRadius="@dimen/card_bg_radius"    android:topRightRadius="@dimen/card_bg_radius"    android:bottomLeftRadius="@dimen/card_bg_radius"    android:bottomRightRadius="@dimen/card_bg_radius">    <child>        <shape android:shape="rectangle">            <corners                android:topLeftRadius="@dimen/card_bg_radius"                android:topRightRadius="@dimen/card_bg_radius"                android:bottomLeftRadius="@dimen/card_bg_radius"                android:bottomRightRadius="@dimen/card_bg_radius" />            <solid android:color="@color/card_bg_color" />        </shape>    </child></miuix.smooth.MySmoothContainerDrawable>