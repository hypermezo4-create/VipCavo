<?xml version="1.0" encoding="utf-8"?><PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"    android:title="@string/iback_mezo_st_5">    <XMiuiColorPickerPreference        android:title="@string/iback_mezo_st_13"        android:key="elem_clock_bg_first_color"        android:defaultValue="#00000000"        alphaSlider="true"        hexValue="true" />    <XMiuiColorPickerPreference        android:title="@string/iback_mezo_st_14"        android:key="elem_clock_bg_second_color"        android:defaultValue="#00000000"        alphaSlider="true"        hexValue="true" />    <XMiuiColorPickerPreference        android:title="@string/iback_mezo_st_15"        android:key="elem_clock_bg_stroke_color"        android:defaultValue="#00000000"        alphaSlider="true"        hexValue="true" />    <XMiuiSeekBarPreference        android:title="@string/iback_mezo_st_6"        android:key="elem_clock_left_margin"        android:defaultValue="0"        enableSummary="true"        max="30"        min="-10" />    <XMiuiSeekBarPreference        android:title="@string/iback_mezo_st_7"        android:key="elem_clock_right_margin"        android:defaultValue="0"        enableSummary="true"        max="30"        min="-10" />    <XMiuiSeekBarPreference        android:title="@string/iback_mezo_st_8"        android:key="elem_clock_left_padd"        android:defaultValue="0"        enableSummary="true"        max="30"        min="-10" />    <XMiuiSeekBarPreference        android:title="@string/iback_mezo_st_9"        android:key="elem_clock_right_padd"        android:defaultValue="0"        enableSummary="true"        max="30"        min="-10" />    <XMiuiSeekBarPreference        android:title="@string/iback_mezo_st_10"        android:key="elem_clock_bottom_margin"        android:defaultValue="0"        enableSummary="true"        max="30"        min="-10" />    <XMiuiSeekBarPreference        android:title="@string/iback_mezo_st_11"        android:key="elem_clock_top_margin"        android:defaultValue="0"        enableSummary="true"        max="30"        min="-10" />    <XMiuiSeekBarPreference        android:title="@string/iback_mezo_st_12"        android:key="elem_clock_bg_stroke_width"        android:defaultValue="0"        enableSummary="true"        max="5"        min="0" />    <XMiuiSeekBarPreference        android:title="@string/iback_mezo_st_16"        android:key="elem_clock_bg_LT_corner"        android:defaultValue="35"        enableSummary="true"        max="90"        min="-25" />    <XMiuiSeekBarPreference        android:title="@string/iback_mezo_st_17"        android:key="elem_clock_bg_RT_corner"        android:defaultValue="35"        enableSummary="true"        max="90"        min="-25" />    <XMiuiSeekBarPreference        android:title="@string/iback_mezo_st_18"        android:key="elem_clock_bg_LB_corner"        android:defaultValue="35"        enableSummary="true"        max="90"        min="-25" />    <XMiuiSeekBarPreference        android:title="@string/iback_mezo_st_19"        android:key="elem_clock_bg_RB_corner"        android:defaultValue="35"        enableSummary="true"        max="90"        min="-25" /></PreferenceScreen>