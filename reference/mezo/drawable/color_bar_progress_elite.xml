<?xml version="1.0" encoding="utf-8"?><layer-list xmlns:android="http://schemas.android.com/apk/res/android">    <item android:id="@android:id/background">        <shape            android:tint="#FFE0E0E0"            android:shape="rectangle">            <corners android:radius="@01050113" />            <size android:height="10dp" />        </shape>    </item>    <item android:id="@android:id/secondaryProgress">        <scale android:scaleWidth="100%">            <shape                android:tint="#FF9E9E9E"                android:shape="rectangle">                <corners android:radius="@01050113" />                <size android:height="10dp" />            </shape>        </scale>    </item>    <item android:id="@android:id/progress">        <scale android:scaleWidth="100%">            <shape                android:tint="?android:attr/colorControlActivated"                android:shape="rectangle">                <corners android:radius="@01050113" />                <size android:height="10dp" />                <solid android:color="#FF2196F3" />            </shape>        </scale>    </item></layer-list>